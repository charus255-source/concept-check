# Copy to .env for local runs. On Vercel, set these in Project Settings > Environment Variables.
GROQ_API_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
# A separate random value of at least 32 characters, used only to sign sessions.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
